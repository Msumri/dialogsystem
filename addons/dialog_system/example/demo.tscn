[ext_resource type="Script" uid="uid://bfh88jx0t282c" path="res://addons/dialog_system/example/npc_AL.gd" id="1_n7tud"]

[sub_resource type="GDScript" id="GDScript_ghs6p"]
script/source = "extends Button


var dialog
func _ready() -> void:
	var dio=Dialog.new()
	dialog=dio.start(self)
	dialog.npc_name=\"Saliba\"
	dialog.image=\"res://addons/dialog_system/example/saliba.png\"
	
func talk():
	
	dialog.text=\"hello there how are you ?\"
	dialog.sound=\"res://addons/dialog_system/coin.mp3\"
	dialog.text=\"do you like apples?\"
	
	#to add a question with menu
	dialog.menu(\"do you like apples?\", {
			\"Yes\": \"yes_function\",
			\"No\": \"No_function\",
		})
func yes_function():
	dialog.text=\"Great I love them too\"
	dialog.sound=\"res://addons/dialog_system/coin.mp3\"
	

func No_function():
	dialog.sound=\"res://addons/dialog_system/coin.mp3\"
	dialog.text=\"oh they are healthy. they keep the Dr. Away\"



func _on_pressed() -> void:
	talk()
"

